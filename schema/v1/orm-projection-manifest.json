{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/declarative-migrations/declmig-interfaces/schema/v1/orm-projection-manifest.json",
  "title": "OrmProjectionManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "orm", "generator", "catalogSha256", "semanticModel"],
  "properties": {
    "format": {"const": "declmig.orm-projection/v1"},
    "orm": {"enum": ["seaorm", "diesel"]},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "binarySha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "binarySha256": {"$ref": "#/$defs/sha256"},
        "lockfileSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "catalogSha256": {"$ref": "#/$defs/sha256"},
    "semanticModel": {
      "$ref": "#/$defs/semanticModel"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "semanticModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tables"],
      "properties": {
        "tables": {
          "type": "array",
          "items": {"$ref": "#/$defs/table"}
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "name",
        "columns",
        "primaryKey",
        "uniqueConstraints",
        "foreignKeys"
      ],
      "properties": {
        "schema": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "columns": {
          "type": "array",
          "items": {"$ref": "#/$defs/column"}
        },
        "primaryKey": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "uniqueConstraints": {
          "type": "array",
          "items": {"$ref": "#/$defs/namedColumns"}
        },
        "foreignKeys": {
          "type": "array",
          "items": {"$ref": "#/$defs/foreignKey"}
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sqlType",
        "rustType",
        "nullable",
        "generated"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sqlType": {"type": "string", "minLength": 1},
        "rustType": {"type": "string", "minLength": 1},
        "nullable": {"type": "boolean"},
        "generated": {"type": "boolean"},
        "defaultSql": {"type": ["string", "null"]},
        "generatedSql": {"type": ["string", "null"]}
      }
    },
    "namedColumns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "columns"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "foreignKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "columns",
        "referencedSchema",
        "referencedTable",
        "referencedColumns",
        "onDelete",
        "onUpdate"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "referencedSchema": {"type": "string", "minLength": 1},
        "referencedTable": {"type": "string", "minLength": 1},
        "referencedColumns": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "onDelete": {
          "enum": ["no-action", "restrict", "cascade", "set-null", "set-default"]
        },
        "onUpdate": {
          "enum": ["no-action", "restrict", "cascade", "set-null", "set-default"]
        }
      }
    }
  }
}
